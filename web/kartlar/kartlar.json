 "kartlar": [
  {
   "id": "kart-01-vetosuz",
   "tur": "sayi",
   "buyuk": {
    "tr": "264 / 266",
    "en": "264 / 266"
   },
   "metin": {
    "tr": "Veto ile düşen 266 önerinin 264'ü, veto olmasaydı kayıtlı oylarla kabul edilmiş olurdu. Oy dağılımı kayıtlı olmayan 2 kapalı oturum vetosu hariç.",
    "en": "Of the 266 vetoed proposals, 264 would have been adopted on the recorded votes had there been no veto. Excluding 2 private-meeting vetoes with no recorded vote breakdown."
   },
   "kaynak": {
    "tr": "DHL veto listesi ve S/PV kayıtları, 17 Eylül 2026",
    "en": "DHL veto list and S/PV records, 17 September 2026"
   }
  },
  {
   "id": "kart-02-tek-ret",
   "tur": "sayi",
   "buyuk": {
    "tr": "55",
    "en": "55"
   },
   "metin": {
    "tr": "55 öneri, Konsey'in öbür bütün üyeleri lehte oy verirken tek bir ret oyuyla düştü. 27'si 11 üyeli Konsey'de (1966 öncesi) oylandı.",
    "en": "55 proposals failed on a single negative vote while every other member of the Council voted in favour. 27 of them were voted on in the 11-member Council (before 1966)."
   },
   "kaynak": {
    "tr": "DHL veto listesi ve S/PV kayıtları, 17 Eylül 2026",
    "en": "DHL veto list and S/PV records, 17 September 2026"
   }
  },
  {
   "id": "kart-03-genel-kurul",
   "tur": "sayi",
   "buyuk": {
    "tr": "22 / 22",
    "en": "22 / 22"
   },
   "metin": {
    "tr": "Nisan 2022'den bu yana veto ile düşen 22 önerinin 22'si Genel Kurul'da görüşüldü. Veto eden ülke 15 veto girişimi tartışmasının 15'inde söz aldı.",
    "en": "Since April 2022, 22 of the 22 vetoed proposals have been debated in the General Assembly. The vetoing country took the floor in 15 of the 15 veto initiative debates."
   },
   "kaynak": {
    "tr": "A/RES/76/262, A/…/PV kayıtları ve BM Günlüğü, 17 Eylül 2026",
    "en": "A/RES/76/262, A/…/PV records and UN Journal, 17 September 2026"
   }
  },
  {
   "id": "kart-04-besi-de",
   "tur": "uyeler",
   "buyuk": {
    "tr": "322",
    "en": "322"
   },
   "metin": {
    "tr": "1946'dan bu yana 322 ret oyu; beş daimî üyenin hepsi veto kullandı. Kapalı oturumdaki 2 veto üye toplamına girmez.",
    "en": "322 negative votes since 1946; all five permanent members have used the veto. The 2 private-meeting vetoes are not included in the member totals."
   },
   "kaynak": {
    "tr": "DHL veto listesi ve S/PV kayıtları, 17 Eylül 2026",
    "en": "DHL veto list and S/PV records, 17 September 2026"
   }
  },
  {
   "id": "kart-05-konular",
   "tur": "sayi",
   "buyuk": {
    "tr": "4 konu",
    "en": "4 topics"
   },
   "metin": {
    "tr": "Dört konuda en çok ret oyu kullanan üyeler: Filistin – ABD 42, Suriye – Rusya Federasyonu 18, Güney Afrika – Birleşik Krallık 24, Üyelik başvuruları – Sovyetler Birliği 51. Yalnızca kaydın ana konusu sayılır.",
    "en": "The members with the most negative votes on four topics: Palestine – United States 42, Syria – Russian Federation 18, South Africa – United Kingdom 24, Membership applications – Soviet Union 51. Only the main topic of each record is counted."
   },
   "kaynak": {
    "tr": "Gündem sözlüğü (ana konu), 17 Eylül 2026",
    "en": "Agenda glossary (main topic), 17 September 2026"
   }
  },
  {
   "id": "kart-09-asya-pasifik",
   "tur": "temsil",
   "gorsel": {
    "nufus": 0.577536,
    "koltuk": 0.2,
    "daimi": 1,
    "secilmis": 2
   },
   "buyuk": {
    "tr": "%57,8",
    "en": "57.8%"
   },
   "metin": {
    "tr": "Asya-Pasifik Grubu'nun 54 üyesi BM üyeleri nüfusunun %57,8'ini oluşturuyor; Güvenlik Konseyi'nin 15 koltuğundan 3'ü (%20,0) bu grupta, bunun 1'i daimî. Nüfus 2023 tahmini (WPP 2024), koltuklar mevcut dönem (2026).",
    "en": "The 54 members of the Asia-Pacific Group make up 57.8% of the population of UN Member States; 3 of the Security Council's 15 seats (20.0%) are in this group, 1 of them permanent. Population: 2023 estimate (WPP 2024); seats: current term (2026)."
   },
   "kaynak": {
    "tr": "WPP 2024, bütçe ölçeği 2025–27, barış gücü Şubat 2026, Konsey 2026",
    "en": "WPP 2024, budget scale 2025–27, peacekeeping February 2026, Council 2026"
   }
  },
  {
   "id": "kart-10-afrika",
   "tur": "temsil",
   "gorsel": {
    "nufus": 0.182518,
    "koltuk": 0.2,
    "daimi": 0,
    "secilmis": 3
   },
   "buyuk": {
    "tr": "0 / 5",
    "en": "0 / 5"
   },
   "metin": {
    "tr": "Afrika Grubu'nun 54 üyesi barış gücü üniformalı personelinin %39,1'ini sağlıyor ve olağan bütçe ölçeğinin %1,1'ini ödüyor; Konsey'de 3 seçilmiş koltuğu (%20,0) var, daimî koltuğu yok. Personel 28 Şubat 2026, ölçek 2025–2027, nüfus 2023.",
    "en": "The 54 members of the African Group provide 39.1% of peacekeeping uniformed personnel and pay 1.1% of the regular budget scale; the group holds 3 elected seats on the Council (20.0%) and no permanent seat. Personnel 28 February 2026, scale 2025–2027, population 2023."
   },
   "kaynak": {
    "tr": "WPP 2024, bütçe ölçeği 2025–27, barış gücü Şubat 2026, Konsey 2026",
    "en": "WPP 2024, budget scale 2025–27, peacekeeping February 2026, Council 2026"
   }
  },
  {
   "id": "kart-11-p5",
   "tur": "temsil",
   "gorsel": {
    "nufus": 0.255604,
    "koltuk": 0.333333,
    "daimi": 5,
    "secilmis": 0
   },
   "buyuk": {
    "tr": "5 / 5",
    "en": "5 / 5"
   },
   "metin": {
    "tr": "Beş daimî üye BM üyeleri nüfusunun %25,6'sını oluşturuyor, olağan bütçe ölçeğinin %51,9'unu ödüyor ve 15 koltuğun 5'ini (%33,3) tutuyor; daimî koltukların tamamı bu beş üyede. Nüfus 2023 tahmini (WPP 2024), ölçek 2025–2027.",
    "en": "The five permanent members make up 25.6% of the population of UN Member States, pay 51.9% of the regular budget scale and hold 5 of the 15 seats (33.3%); all permanent seats are theirs. Population: 2023 estimate (WPP 2024); scale 2025–2027."
   },
   "kaynak": {
    "tr": "WPP 2024, bütçe ölçeği 2025–27, barış gücü Şubat 2026, Konsey 2026",
    "en": "WPP 2024, budget scale 2025–27, peacekeeping February 2026, Council 2026"
   }
  },
  {
   "id": "kart-06-alinti-2026",
   "tur": "alinti",
   "buyuk": {
    "tr": "190’dan fazla ülkenin iradesinin 5 ülkenin keyfine bağlı olduğu bir yapı, kabul edelim ki, ne âdildir, ne de güveni tam manasıyla tesis edebilir.",
    "en": "Let’s recognize that a system in which the will of more than 190 countries is subject to the whims of five countries is neither fair nor capable of fully establishing trust."
   },
   "metin": {
    "tr": "Cumhurbaşkanı Recep Tayyip Erdoğan",
    "en": "President Recep Tayyip Erdoğan"
   },
   "kaynak": {
    "tr": "BM 81. Genel Kurulu hitabı · 22 Eylül 2026 · s. 16",
    "en": "Address to the 81st Session of the UN General Assembly · 22 September 2026 · p. 116"
   }
  },
  {
   "id": "kart-07-alinti-2025",
   "tur": "alinti",
   "buyuk": {
    "tr": "Görevimiz sistemi terk etmek değil; onarmak, yeniden işler hale getirmektir.",
    "en": "Our duty is not to abandon the system but to fix it and restore its functionality."
   },
   "metin": {
    "tr": "Cumhurbaşkanı Recep Tayyip Erdoğan",
    "en": "President Recep Tayyip Erdoğan"
   },
   "kaynak": {
    "tr": "BM 80. Genel Kurulu hitabı · 23 Eylül 2025 · s. 49",
    "en": "Address to the 80th Session of the UN General Assembly · 23 September 2025 · p. 151"
   }
  },
  {
   "id": "kart-08-alinti-2019",
   "tur": "alinti",
   "buyuk": {
    "tr": "Bu kürsüden yıllardır insanlığın kaderinin sınırlı sayıdaki ülkenin ihtiyarına bırakılamayacağını söylüyorum. Burada sizlerin huzurunda tekrar ediyorum; “Dünya 5’ten Büyüktür.”",
    "en": "I have been saying for years that we cannot afford to place humanity’s fate into the hands of a small group of nations. Today, in your presence, I say again: The world is bigger than five!"
   },
   "metin": {
    "tr": "Cumhurbaşkanı Recep Tayyip Erdoğan",
    "en": "President Recep Tayyip Erdoğan"
   },
   "kaynak": {
    "tr": "BM 74. Genel Kurulu konuşması · 24 Eylül 2019 · s. 6",
    "en": "Address to the 74th Session of the UN General Assembly · 24 September 2019 · p. 6"
   }
  }
