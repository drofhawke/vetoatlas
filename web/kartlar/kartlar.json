   "tur": "sayi",
   "buyuk": {
    "tr": "22 / 22",
    "en": "22 / 22"
   },
   "metin": {
    "tr": "Nisan 2022’den bu yana veto nedeniyle kabul edilemeyen 22 önerinin tamamı Genel Kurulda görüşülmüştür.",
    "en": "All 22 proposals vetoed since April 2022 have been debated in the General Assembly."
   },
   "kaynak": {
    "tr": "A/RES/76/262, A/…/PV kayıtları ve BM Günlüğü, 17 Eylül 2026",
    "en": "A/RES/76/262, A/…/PV records and UN Journal, 17 September 2026"
   }
  },
  {
   "id": "kart-04-besi-de",
   "tur": "uyeler",
   "buyuk": {
    "tr": "322",
    "en": "322"
   },
   "metin": {
    "tr": "1946’dan bu yana 322 ret oyu kullanılmış olup beş daimî üyenin tamamı vetoya başvurmuştur. Kapalı oturumdaki 2 veto üye toplamlarına dâhil değildir.",
    "en": "322 negative votes have been cast since 1946, and all five permanent members have used the veto. The 2 private-meeting vetoes are not included in the member totals."
   },
   "kaynak": {
    "tr": "DHL veto listesi ve S/PV kayıtları, 17 Eylül 2026",
    "en": "DHL veto list and S/PV records, 17 September 2026"
   }
  },
  {
   "id": "kart-05-konular",
   "tur": "sayi",
   "buyuk": {
    "tr": "4 konu",
    "en": "4 topics"
   },
   "metin": {
    "tr": "Dört konuda en çok ret oyu kullanan üye, konudaki bütün ret oylarıyla birlikte gösterilmektedir. Sayımda yalnızca kaydın ana konusu esas alınmaktadır.",
    "en": "The member with the most negative votes on each of four topics is shown against all negative votes on that topic. Only the main topic of each record is counted."
   },
   "kaynak": {
    "tr": "Gündem sözlüğü (ana konu), 17 Eylül 2026",
    "en": "Agenda glossary (main topic), 17 September 2026"
   }
