  {
   "id": "kart-01-vetosuz",
   "tur": "sayi",
   "buyuk": {
    "tr": "264 / 266",
    "en": "264 / 266"
   },
   "metin": {
    "tr": "Veto nedeniyle kabul edilemeyen 266 önerinin 264’ü, veto olmasaydı kayıtlı oylarla kabul edilmiş olacaktı. Kalan 2 veto kapalı oturumda kullanılmış olup oy dağılımları kayıtlı değildir.",
    "en": "Of the 266 proposals not adopted owing to a veto, 264 would have been adopted on the recorded votes had there been no veto. The remaining 2 vetoes were cast in private meetings, and their votes are not on record."
   },
   "kaynak": {
    "tr": "DHL veto listesi ve S/PV kayıtları, 17 Eylül 2026",
    "en": "DHL veto list and S/PV records, 17 September 2026"
   }
  },
  {
   "id": "kart-02-tek-ret",
   "tur": "sayi",
   "buyuk": {
    "tr": "55",
    "en": "55"
   },
   "metin": {
    "tr": "55 öneri, Konseyin diğer bütün üyeleri olumlu oy kullanmış olmasına rağmen tek bir ret oyu nedeniyle kabul edilememiştir.",
    "en": "55 proposals were not adopted on a single negative vote, although every other member of the Council voted in favour."
   },
   "kaynak": {
    "tr": "DHL veto listesi ve S/PV kayıtları, 17 Eylül 2026",
    "en": "DHL veto list and S/PV records, 17 September 2026"
   }
  },
  {
